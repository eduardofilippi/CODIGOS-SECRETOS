# Variables del microsite. Copiar a `.env` y completar.
# `.env` NO se sube al repo: sólo este ejemplo, sin valores reales.

# ---------------------------------------------------------------------------
# API del backend
# ---------------------------------------------------------------------------
# Base de la API. Vacía = el sitio usa el adapter mock (datos de ejemplo).
# Con la URL del backend (codigos-secretos-backend) cargada, el sitio pasa
# solo al adapter real (HttpPromoApi); no hay que tocar código.
# Ej.: VITE_API_URL=http://localhost:3001
VITE_API_URL=

# ---------------------------------------------------------------------------
# reCAPTCHA v3
# ---------------------------------------------------------------------------
# La clave es de reCAPTCHA en Google Cloud (Enterprise): el sitio carga
# `enterprise.js` y usa `grecaptcha.enterprise`, pero el token viaja igual.
#
# Sólo la clave del SITIO va acá: es pública y viaja al navegador.
# La clave SECRETA nunca se pone en este archivo ni en ninguna variable VITE_:
# todo lo que empieza con VITE_ termina dentro del JavaScript publicado y
# cualquiera puede leerlo. La secreta vive únicamente en el backend, que es
# quien verifica el token contra Google.
#
# Mientras esté vacía, el sitio no carga nada de Google y manda el código sin
# token; el backend decide si en ese caso acepta o rechaza.
VITE_RECAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Figma (sólo herramientas de desarrollo, nunca llega al navegador)
# ---------------------------------------------------------------------------
# Token personal para bajar el diseño exacto con `npm run figma:pull`.
# Se saca en figma.com → perfil → Configuración → Seguridad →
# "Tokens de acceso personal", con permiso de lectura de archivos.
#
# Ojo: NO lleva el prefijo VITE_ a propósito. Todo lo que empieza con VITE_
# termina dentro del JavaScript publicado; este token no debe salir de tu
# máquina.
FIGMA_TOKEN=
